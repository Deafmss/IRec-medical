{
  "name": "irec",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "eslint .",
    "lint:ci": "node scripts/ci-lint-gate.mjs",
    "verificar": "npm run lint && npm test && node scripts/verificar-catalogo.mjs && npm run build",
    "test": "vitest run",
    "preview": "vite preview",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "verificar:catalogo": "node scripts/verificar-catalogo.mjs",
    "prepare": "husky",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "audit": "npm audit --audit-level=high"
  },
  "dependencies": {
    "@capacitor/android": "^8.4.2",
    "@capacitor/core": "^8.4.2",
    "@capacitor/ios": "^8.4.2",
    "@sentry/react": "^10.69.0",
    "@supabase/supabase-js": "^2.108.2",
    "lucide-react": "^1.29.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.4.2",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.50.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.4",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "husky": "^9.1.7",
    "jsdom": "^29.1.1",
    "lint-staged": "^17.3.0",
    "typescript": "^5.9.3",
    "vite": "^8.0.12",
    "vitest": "^4.1.10"
  },
  "lint-staged": {
    "src/**/*.{js,jsx}": [
      "eslint --fix"
    ]
  },
  "description": "iRec - plataforma de atendimento em saude, telemedicina e prevencao de feridas"
}
